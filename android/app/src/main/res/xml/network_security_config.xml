<?xml version="1.0" encoding="utf-8"?>
<!--
  Release/default: HTTPS/WSS only. No cleartext is permitted in any build
  that uses the main source set (app:networkSecurityConfig points here).
  Local development cleartext (ws://10.0.2.2, LAN signaling) lives ONLY in the
  debug source-set config referenced by app/src/debug/AndroidManifest.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
