# ---- Server ----
PORT=8080
HOST=0.0.0.0

# ---- Authentication ----
# backend : verify the app's session token against the OllaCore API
#           GET {API_BASE}/directory/me  (identity is taken from the response,
#           NEVER from the client). This reuses the application's existing auth.
# dev     : accept tokens of the form "dev:<userId>" - LOCAL TESTING ONLY.
AUTH_MODE=backend
API_BASE=https://api.ollacore.com/v1

# ---- STUN / TURN (sent to clients after auth; never hard-code in the app) ----
# Comma-separated lists.
STUN_URLS=stun:stun.l.google.com:19302
# Option A - static TURN credentials (from your TURN provider dashboard):
#TURN_URLS=turn:turn.example.com:3478
#TURN_USERNAME=user
#TURN_CREDENTIAL=secret
# Option B - short-lived (recommended): coturn with use-auth-secret.
# The server mints time-limited credentials per user (HMAC-SHA1).
#TURN_URLS=turn:turn.example.com:3478
#TURN_SECRET=coturn-static-auth-secret-value
#TURN_TTL_SEC=3600

# ---- Call timeouts (ms) ----
RING_TIMEOUT_MS=45000
ANSWER_TIMEOUT_MS=60000
DISCONNECT_GRACE_MS=15000

# ---- Optional TLS (serve wss:// directly; otherwise terminate TLS upstream) ----
#TLS_KEY=/path/to/privkey.pem
#TLS_CERT=/path/to/fullchain.pem

# ---- Limits ----
MAX_FRAME_BYTES=262144
RATE_LIMIT_PER_SEC=60
